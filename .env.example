# Agent Ops — environment variables
# Copy this file to .env, fill in the real values, and never commit .env itself
# (it should already be in .gitignore before Claude Code touches this folder).

# --- LLM providers -----------------------------------------------------
# Primary model. Get a free key (no card) at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Which Gemini model to call — change here, not in code.
# gemini-2.0-flash was RETIRED March 2026 — do not use it (see ADR-002).
# gemini-3.1-flash-lite verified current + cost-effective as of 2026-08-22.
GEMINI_MODEL=gemini-3.1-flash-lite

# Backup/fallback model, used automatically if Gemini errors, times out, or
# rate-limits. Get a free key (no card) at https://openrouter.ai/keys
# Free-tier cap: 20 requests/min, 50/day per model with no credit on file.
OPENROUTER_API_KEY=
# Pick a current free (":free"-suffixed) tool-calling-capable model from
# https://openrouter.ai/api/v1/models — this list changes often, so check it
# live rather than trusting an old value here (see ADR-002 for the method).
# Verified live 2026-08-22: fullest tool-calling parameter support among the
# 17 free+tool-calling candidates at that time.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# --- Database / memory / trace log (Supabase) ---------------------------
# Project Settings -> API on your Supabase project
SUPABASE_URL=
# Server-side secret key (sb_secret_... prefix) — replaces the legacy
# service_role JWT under Supabase's current API key scheme (legacy
# anon/service_role keys are being retired through end of 2026). Never
# expose this to the frontend; only backend/ reads it.
SUPABASE_SECRET_KEY=
# Project Settings -> Database -> Connection string (use the pooled one).
# If the DB password contains special characters (@, :, /, #, etc.) they
# MUST be percent-encoded (@ -> %40) or the URI will parse incorrectly.
DATABASE_URL=

# --- App config -----------------------------------------------------
# development | production
ENVIRONMENT=development
# Port the FastAPI backend runs on locally
PORT=8000
# Comma-separated origins allowed to call the backend (add your Vercel URL
# once it exists, e.g. https://agent-ops.vercel.app)
CORS_ORIGINS=http://localhost:5173
# debug | info | warning | error
LOG_LEVEL=info

# --- Frontend (goes in frontend/.env, Vite requires the VITE_ prefix) ----
# Local dev: http://localhost:8000 — after Day 6's deploy, point this at
# the live Render URL instead
VITE_API_URL=http://localhost:8000

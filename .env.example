# Agent Ops — environment variables
# Copy this file to .env, fill in the real values, and never commit .env itself
# (it should already be in .gitignore before Claude Code touches this folder).

# --- LLM providers -----------------------------------------------------
# Primary model. Get a free key (no card) at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Which Gemini model to call — change here, not in code
GEMINI_MODEL=gemini-2.0-flash

# Backup/fallback model, used automatically if Gemini errors, times out, or
# rate-limits. Get a free key (no card) at https://openrouter.ai/keys
# Free-tier cap: 20 requests/min, 50/day per model with no credit on file.
OPENROUTER_API_KEY=
# Pick a current free (":free"-suffixed) tool-calling-capable model from
# https://openrouter.ai/models?max_price=0 — this list changes often, so
# check it live rather than trusting an old value here.
OPENROUTER_MODEL=

# --- Database / memory / trace log (Supabase) ---------------------------
# Project Settings -> API on your Supabase project
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Project Settings -> Database -> Connection string (use the pooled one)
DATABASE_URL=

# --- App config -----------------------------------------------------
# development | production
ENVIRONMENT=development
# Port the FastAPI backend runs on locally
PORT=8000
# Comma-separated origins allowed to call the backend (add your Vercel URL
# once it exists, e.g. https://agent-ops.vercel.app)
CORS_ORIGINS=http://localhost:5173
# debug | info | warning | error
LOG_LEVEL=info

# --- Frontend (goes in frontend/.env, Vite requires the VITE_ prefix) ----
# Local dev: http://localhost:8000 — after Day 6's deploy, point this at
# the live Render URL instead
VITE_API_URL=http://localhost:8000

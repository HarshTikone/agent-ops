# Vite only loads .env files from within frontend/ itself — copy this to
# frontend/.env for local dev. Only VITE_-prefixed vars are ever exposed to
# client code; never put a secret behind this prefix.

# Optional in development (defaults to http://localhost:8000), but required
# for every production build. Set it to the exact HTTPS Render origin.
VITE_API_URL=http://localhost:8000

# The operator key is deliberately not a VITE_* variable. Enter it in the
# application at runtime so it is never compiled into the public bundle.
